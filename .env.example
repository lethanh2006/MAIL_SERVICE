NODE_ENV=development
PORT=5001

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@example.com
SMTP_PASS=replace-with-an-app-password
MAIL_FROM=your-email@example.com

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
